    S_CBRANCH_VCCNZ %bb.1, implicit killed $vcc_lo, implicit $vcc
    S_BRANCH %bb.5

  bb.5:
    ; Use the pressure registers to keep them alive
    S_NOP 0, implicit %100, implicit %101, implicit %102, implicit %103
    S_NOP 0, implicit %104, implicit %105, implicit %106, implicit %107
    S_NOP 0, implicit %108, implicit %109, implicit %110, implicit %111
    S_NOP 0, implicit %112, implicit %113, implicit %114, implicit %115
    S_NOP 0, implicit %116, implicit %117, implicit %118, implicit %119
    S_NOP 0, implicit %120, implicit %121, implicit %122, implicit %123
    SI_RETURN
