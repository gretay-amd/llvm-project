name:            waterfall_cmpx_low_pressure
tracksRegLiveness: true
machineFunctionInfo:
  isEntryFunction: false
  scratchRSrcReg:  '$private_rsrc_reg'
  stackPtrOffsetReg: '$sgpr32'
  frameOffsetReg:  '$sgpr33'
  sgprForEXECCopy: '$sgpr105'
  occupancy:       16
registers:
  - { id: 0, class: vgpr_32 }
  - { id: 1, class: vgpr_32 }
  - { id: 2, class: vreg_64 }
  - { id: 3, class: vreg_128 }
  - { id: 4, class: sreg_32_xm0_xexec }
  - { id: 5, class: sreg_32_xm0_xexec }
  - { id: 6, class: sreg_32_xm0_xexec }
  - { id: 7, class: sreg_32_xm0 }
  - { id: 8, class: sreg_32_xm0 }
  - { id: 9, class: sgpr_64 }
  - { id: 10, class: sreg_32_xm0 }
  - { id: 11, class: sreg_32_xm0 }
  - { id: 12, class: sgpr_64 }
  - { id: 13, class: sgpr_128 }
  - { id: 14, class: vgpr_32 }
  - { id: 15, class: vgpr_32 }
  - { id: 16, class: sreg_32 }
  - { id: 17, class: vreg_128 }
liveins:
  - { reg: '$vgpr0', virtual-reg: '%0' }
  - { reg: '$vgpr1', virtual-reg: '%1' }
body:             |
  ; NEVER-LABEL: name: waterfall_cmpx_low_pressure
