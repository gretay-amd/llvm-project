# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=si-opt-vgpr-liverange -amdgpu-waterfall-cmpx-placement-optimization=never %s -o - | FileCheck %s --check-prefix=NEVER
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=si-opt-vgpr-liverange -amdgpu-waterfall-cmpx-placement-optimization=always %s -o - | FileCheck %s --check-prefix=ALWAYS
# RUN: llc -mtriple=amdgcn -mcpu=gfx1100 -run-pass=si-opt-vgpr-liverange -amdgpu-waterfall-cmpx-placement-optimization=estimate-register-pressure %s -o - | FileCheck %s --check-prefix=ESTIMATE

# Test the three modes of -amdgpu-waterfall-cmpx-placement-optimization:
#   never:                       keep cmpx_term at end of header
#   always:                      always move cmpx_term earlier
#   estimate-register-pressure:  move only when header has high VGPR pressure
#
# Two functions:
#   waterfall_cmpx_high_pressure: many vreg_128 live through the header.
#     - never: deferred (no split).
#     - always and estimate: moved (block is split).
#   waterfall_cmpx_low_pressure: no live-through pressure.
#     - never and estimate: deferred (no split).
#     - always: moved (block is split).

--- |
  define void @waterfall_cmpx_high_pressure(ptr %arg) #0 {
    ret void
  }

  define void @waterfall_cmpx_low_pressure(ptr %arg) #0 {
    ret void
  }

  attributes #0 = { nounwind "amdgpu-waves-per-eu"="16,16" }
...
