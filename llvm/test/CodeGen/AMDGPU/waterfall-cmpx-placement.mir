    V_CMPX_EQ_U64_nosdst_e32_term killed %12, killed %17.sub2_sub3, implicit-def $exec, implicit $exec

  bb.3:
    successors: %bb.2(0x40000000), %bb.4(0x40000000)

    BUFFER_STORE_DWORD_OFFEN_exact undef %14:vgpr_32, undef %15:vgpr_32, killed %13, 0, 0, 0, 0, implicit $exec
    %6:sreg_32_xm0_xexec = S_ANDN2_WREXEC_B32 killed %5, implicit-def $exec, implicit-def dead $scc, implicit $exec
