    %100:vreg_128 = FLAT_LOAD_DWORDX4 %2, 0, 0, implicit $exec, implicit $flat_scr
    %101:vreg_128 = FLAT_LOAD_DWORDX4 %2, 16, 0, implicit $exec, implicit $flat_scr
