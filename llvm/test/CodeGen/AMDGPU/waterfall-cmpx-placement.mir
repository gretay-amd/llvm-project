    %118:vreg_128 = FLAT_LOAD_DWORDX4 %2, 288, 0, implicit $exec, implicit $flat_scr
    %119:vreg_128 = FLAT_LOAD_DWORDX4 %2, 304, 0, implicit $exec, implicit $flat_scr
    %120:vreg_128 = FLAT_LOAD_DWORDX4 %2, 320, 0, implicit $exec, implicit $flat_scr
    %121:vreg_128 = FLAT_LOAD_DWORDX4 %2, 336, 0, implicit $exec, implicit $flat_scr
