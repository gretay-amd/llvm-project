  ; NEVER-NEXT:   [[PHI2:%[0-9]+]]:vreg_128 = PHI [[FLAT_LOAD_DWORDX4_]], %bb.1, undef %19:vreg_128, %bb.3
  ; NEVER-NEXT:   [[V_READFIRSTLANE_B32_:%[0-9]+]]:sreg_32_xm0 = V_READFIRSTLANE_B32 [[PHI1]].sub0, implicit $exec
  ; NEVER-NEXT:   [[V_READFIRSTLANE_B32_1:%[0-9]+]]:sreg_32_xm0 = V_READFIRSTLANE_B32 [[PHI1]].sub1, implicit $exec
  ; NEVER-NEXT:   [[REG_SEQUENCE1:%[0-9]+]]:sgpr_64 = REG_SEQUENCE [[V_READFIRSTLANE_B32_]], %subreg.sub0, [[V_READFIRSTLANE_B32_1]], %subreg.sub1
